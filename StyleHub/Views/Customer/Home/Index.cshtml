@using StyleHub.Core.Models;
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Home Page";
    Layout = "_CustomerLayout";
}

<!-- Slider -->
<section class="section-slide">
    <div class="wrap-slick1">
        <div class="slick1">
            @* الشريحة الأولى *@
            <div class="item-slick1" style="background-image: url('@Url.Content("~/images/slide-01.jpg")');">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                        <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                            <span class="ltext-101 cl2 respon2">
                                Women Collection 2026
                            </span>
                        </div>

                        <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                            <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">
                                NEW SEASON
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

            @* الشريحة الثانية *@
            <div class="item-slick1" style="background-image: url('@Url.Content("~/images/slide-02.jpg")');">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                        <div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
                            <span class="ltext-101 cl2 respon2">
                                Men New-Season
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product Grid -->
<section class="bg0 p-t-23 p-b-140">
    <div class="container">
        <div class="p-b-10">
            <h2 class="ltext-103 cl5">
                Shop Now
                Our Products
            </h2>
        </div>

        <div class="row isotope-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item">
                        <div class="block2">
                            <div class="block2-pic hov-img0">
                                @* استخدام asp-append-version لضمان معالجة المسار بشكل صحيح *@
                                <img src="~/images/@product.ImageUrl" asp-append-version="true" alt="@product.Name">

                                <a href="#" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                    Quick View
                                </a>
                            </div>

                            <div class="block2-txt flex-w flex-t p-t-14">
                                <div class="block2-txt-child1 flex-col-l">
                                    <a href="#" class="stext-104 cl4 hov-cl1 trans-04 p-b-6">
                                        @product.Name
                                    </a>
                                    <span class="stext-105 cl3">
                                        EGP @product.Price
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p>No products found in StyleHub gallery.</p>
                </div>
            }
        </div>
    </div>
</section>